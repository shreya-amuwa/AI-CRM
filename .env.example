# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit real values.
# -----------------------------------------------------------------------------

# Browser (bundled into the frontend - public values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only (Vercel functions + Vite dev API). Never prefix with VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Used only for Supabase Auth admin actions (create/ban users) and inbound webhooks.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: comma-separated origins allowed to call /api/v1 cross-origin.
API_ALLOWED_ORIGINS=

# Optional: per-minute rate limits (defaults shown)
# RATE_LIMIT_IP_PER_MIN=600
# RATE_LIMIT_USER_PER_MIN=300
# RATE_LIMIT_SENSITIVE_PER_MIN=20
# RATE_LIMIT_IMPORT_PER_MIN=5

# Technical Consultant automations - Google Apps Script web app URLs (server only).
# See docs/TECHNICAL_CONSULTANT.md. Leave empty to show "Google Sheet not connected".
# AUTOMATION_EMAIL_WEBHOOK_URL=
# AUTOMATION_WHATSAPP_WEBHOOK_URL=
# AUTOMATION_AI_CALLING_WEBHOOK_URL=
# AUTOMATION_WEBHOOK_SECRET=

# Client login at payment confirmation (docs/CLIENT_ONBOARDING_JOURNEY.md). Default on (needs the service key + e-mail above);
# set to off to create client accounts by hand only (Accounts / Support still have the manual buttons).
# AUTO_CLIENT_LOGIN=off

# Onboarding email + WhatsApp automations (server only). See docs/ONBOARDING_AUTOMATIONS.md.
# off = nothing is processed, dry_run (default) = prepared and logged but never sent, live = sent.
# AUTOMATION_MODE=dry_run
# Subscription expiry reminder calls (7 / 3 / 1 day before). off | dry_run (default). 'live' is refused until a calling provider is connected.
# AUTOMATION_MODE_AI_CALL=dry_run
# Secret Vercel Cron sends as a Bearer token to /api/v1/internal/automations/dispatch (16+ characters; AUTOMATION_DISPATCH_SECRET also works)
# CRON_SECRET=
# Email: a transactional provider sending as meta@amuwa.com (domain verified with the provider).
# EMAIL_PROVIDER=smtp              # smtp (nodemailer), resend or brevo
# SMTP (nodemailer), e.g. the meta@amuwa.com Google Workspace mailbox with an APP password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=meta@amuwa.com
# SMTP_PASS=
# Resend / Brevo only:
# EMAIL_API_KEY=
# EMAIL_FROM=Amuwa Corporation <meta@amuwa.com>
# EMAIL_REPLY_TO=meta@amuwa.com
# EMAIL_CC=
# EMAIL_BCC=
# WhatsApp: the 1automations Automation Builder webhook (regenerate it; never commit it).
# WHATSAPP_WEBHOOK_URL=
# The paid invoice also goes to this webhook (event stage_code INVOICE_PAID) unless Wabastore is set up: see docs/INVOICE_WHATSAPP.md.
# AUTOMATION_MODE_INVOICE_WHATSAPP=live   # optional: when unset, AUTOMATION_MODE decides
# WHATSAPP_SOURCE=Google Sheets    # the "source" value the WhatsApp router receives
# Only these recipients get messages while set (comma separated e-mails and phone numbers).
# AUTOMATION_TEST_RECIPIENTS=
# Encrypts the client password until the "Status Completed" email is sent (any long random string).
# AUTOMATION_SECRET_KEY=
# Bearer secret for POST /api/v1/internal/automations/dispatch (retries / safety net). At least 16 characters.
# AUTOMATION_DISPATCH_SECRET=
# Also skip the email when the WhatsApp number is invalid (the Apps Script's REQUIRE_VALID_WHATSAPP).
# AUTOMATION_REQUIRE_VALID_WHATSAPP=false

# The CRM's own web address, for the link in the emails to the Accounts payment desk (docs/ACCOUNTS_PAYMENT_EMAIL.md)
# APP_URL=https://crm.example.com

# File storage. New customer documents and invoice PDFs go to Cloudflare R2 when these are set (server only).
# Files stored earlier stay in Supabase Storage and keep opening. See docs/CLOUDFLARE_R2.md.
# STORAGE_PROVIDER=r2              # r2 | supabase (unset = r2 when the R2_* values below are all set)
# R2_ACCOUNT_ID=                   # Cloudflare dashboard -> R2 -> account id
# R2_ACCESS_KEY_ID=                # R2 -> Manage API tokens -> Object Read & Write, limited to the bucket
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=                       # the bucket name (create it private; keep "Public access" off)

# Biometric device gateway: the secret (16+ characters) it sends as "Authorization: Bearer <secret>" to
# POST /api/v1/integrations/biometric/punch with {"email": "...", "punchedAt": "2026-10-16T09:08:00+05:30"}.
# Without it the endpoint answers 503 and no biometric punch is recorded.
BIOMETRIC_INGEST_SECRET=

# Inbound lead webhook (/api/webhook, /api/webhooks/...). Senders (n8n, WhatsApp, forms) must send
# "X-Webhook-Secret: <value>" (or "Authorization: Bearer <value>"). Comma separated, each at least 16 characters.
# Until it is set the webhook accepts unauthenticated requests. See docs/SECURITY.md.
# WEBHOOK_SECRET=…
# Meta / WhatsApp subscription handshake: the verify token you typed in the Meta console.
# WEBHOOK_VERIFY_TOKEN=…

# Performance Management: the written analysis of a performance report (server only, never VITE_). Without a key the analysis is
# rule-based and says so. Only report figures, short task titles and delay reasons are sent. See docs/PERFORMANCE_MANAGEMENT.md.
# ANTHROPIC_API_KEY=
# PERFORMANCE_AI_MODEL=claude-sonnet-5-5
# PERFORMANCE_AI_TIMEOUT_MS=40000

# Sign-in location in Security & Audit Logs (Super Admin only). On Vercel the place comes from the platform's own headers: nothing to set.
# TRUST_PROXY_HEADERS=true   only behind a reverse proxy you control that sets x-real-ip / x-forwarded-for itself (not needed on Vercel).
# Optional IP lookup service, used only when the platform sends no place (server only, never VITE_). See docs/SECURITY.md.
# GEOIP_PROVIDER=ipinfo
# GEOIP_API_KEY=
# GEOIP_TIMEOUT_MS=1500
