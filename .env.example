# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit real values.
# -----------------------------------------------------------------------------

# Browser (bundled into the frontend — public values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only (Vercel functions + Vite dev API). Never prefix with VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Used only for Supabase Auth admin actions (create/ban users) and inbound webhooks.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: comma-separated origins allowed to call /api/v1 cross-origin.
API_ALLOWED_ORIGINS=
