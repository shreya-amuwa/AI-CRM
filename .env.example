# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit real values.
# -----------------------------------------------------------------------------

# Browser (bundled into the frontend - public values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only (Vercel functions + Vite dev API). Never prefix with VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Used only for Supabase Auth admin actions (create/ban users) and inbound webhooks.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: comma-separated origins allowed to call /api/v1 cross-origin.
API_ALLOWED_ORIGINS=

# Optional: per-minute rate limits (defaults shown)
# RATE_LIMIT_IP_PER_MIN=600
# RATE_LIMIT_USER_PER_MIN=300
# RATE_LIMIT_SENSITIVE_PER_MIN=20
# RATE_LIMIT_IMPORT_PER_MIN=5

# Technical Consultant automations - Google Apps Script web app URLs (server only).
# See docs/TECHNICAL_CONSULTANT.md. Leave empty to show "Google Sheet not connected".
# AUTOMATION_EMAIL_WEBHOOK_URL=
# AUTOMATION_WHATSAPP_WEBHOOK_URL=
# AUTOMATION_AI_CALLING_WEBHOOK_URL=
# AUTOMATION_WEBHOOK_SECRET=

# Onboarding email + WhatsApp automations (server only). See docs/ONBOARDING_AUTOMATIONS.md.
# off = nothing is processed, dry_run (default) = prepared and logged but never sent, live = sent.
# AUTOMATION_MODE=dry_run
# Email: a transactional provider sending as meta@amuwa.com (domain verified with the provider).
# EMAIL_PROVIDER=resend            # or brevo
# EMAIL_API_KEY=
# EMAIL_FROM=Amuwa Corporation <meta@amuwa.com>
# EMAIL_REPLY_TO=meta@amuwa.com
# EMAIL_CC=
# EMAIL_BCC=
# WhatsApp: the 1automations Automation Builder webhook (regenerate it; never commit it).
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_SOURCE=Google Sheets    # the "source" value the WhatsApp router receives
# Only these recipients get messages while set (comma separated e-mails and phone numbers).
# AUTOMATION_TEST_RECIPIENTS=
# Encrypts the client password until the "Status Completed" email is sent (any long random string).
# AUTOMATION_SECRET_KEY=
# Bearer secret for POST /api/v1/internal/automations/dispatch (retries / safety net). At least 16 characters.
# AUTOMATION_DISPATCH_SECRET=
# Also skip the email when the WhatsApp number is invalid (the Apps Script's REQUIRE_VALID_WHATSAPP).
# AUTOMATION_REQUIRE_VALID_WHATSAPP=false
