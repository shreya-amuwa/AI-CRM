# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit real values.
# -----------------------------------------------------------------------------

# Browser (bundled into the frontend - public values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only (Cloudflare Worker variables / secrets, Vite dev API; Vercel during the move). Never prefix with VITE_.
# On Cloudflare: Worker -> Settings -> Variables and Secrets, or `npx wrangler secret put NAME`. See docs/DEPLOYMENT_CLOUDFLARE.md.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Used only for Supabase Auth admin actions (create/ban users) and inbound webhooks.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: comma-separated origins allowed to call /api/v1 cross-origin.
API_ALLOWED_ORIGINS=

# Optional: per-minute rate limits (defaults shown)
# RATE_LIMIT_IP_PER_MIN=600
# RATE_LIMIT_USER_PER_MIN=300
# RATE_LIMIT_SENSITIVE_PER_MIN=20
# RATE_LIMIT_IMPORT_PER_MIN=5

# Technical Consultant automations - Google Apps Script web app URLs (server only).
# See docs/TECHNICAL_CONSULTANT.md. Leave empty to show "Google Sheet not connected".
# AUTOMATION_EMAIL_WEBHOOK_URL=
# AUTOMATION_WHATSAPP_WEBHOOK_URL=
# AUTOMATION_AI_CALLING_WEBHOOK_URL=
# AUTOMATION_WEBHOOK_SECRET=

# Client login at payment confirmation (docs/CLIENT_ONBOARDING_JOURNEY.md). Default OFF: the client's login and its "set your password"
# e-mail are made when Accounts creates it from Client Logins, not when the customer is returned to Sales. Set to on to also make it at confirmation.
# AUTO_CLIENT_LOGIN=on

# Onboarding email + WhatsApp automations (server only). See docs/ONBOARDING_AUTOMATIONS.md.
# off = nothing is processed, dry_run (default) = prepared and logged but never sent, live = sent.
# AUTOMATION_MODE=dry_run
# Panel recharge reminder calls (7 / 5 / 1 day before expiry). off | dry_run (default) | live. 'live' is refused until a calling provider is connected.
# AUTOMATION_MODE_AI_CALL=dry_run
# The BolifyAI settings (BOLIFY_API_KEY ...) are under "WhatsApp / calling providers" below; docs/BOLIFY_AI.md.
# Secret the scheduled run (Cloudflare Cron Trigger, worker/index.ts) sends as a Bearer token to /api/v1/internal/automations/dispatch
# (16+ characters; AUTOMATION_DISPATCH_SECRET also works)
# CRON_SECRET=
# Email: a transactional provider sending as meta@amuwa.com (domain verified with the provider).
# EMAIL_PROVIDER=ses               # ses (AWS SES, recommended), smtp (the mailbox below), resend or brevo. On Cloudflare: a dashboard variable.
# AWS SES (docs/AWS_SES_SETUP.md): an IAM user allowed only to send from @amuwa.com.
# SES_REGION=ap-south-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=           # optional
# SES_MAX_PER_SECOND=10            # optional: your SES sending rate (dashboard), default 10
# SMTP, e.g. the meta@amuwa.com Google Workspace mailbox with an APP password (nodemailer on Node.js; on the Cloudflare Worker the CRM's
# own SMTP client over Cloudflare sockets). With EMAIL_PROVIDER=ses or resend these are the FALLBACK: an e-mail SES / Resend refuses (daily / monthly
# limit reached, key or domain refused, Resend down) goes out through this mailbox instead. See docs/DEPLOYMENT_CLOUDFLARE.md.
# EMAIL_FALLBACK=off               # optional: never use the mailbox as Resend's fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=meta@amuwa.com
# SMTP_PASS=
# Resend / Brevo only:
# EMAIL_API_KEY=                   # Resend: an API key with Sending access to the verified amuwa.com domain
# RESEND_MAX_PER_SECOND=5          # optional: Resend API calls a second (default 5; raise if your Resend account allows more)
# EMAIL_FROM=Amuwa Corporation <meta@amuwa.com>
# EMAIL_REPLY_TO=meta@amuwa.com
# Optional: e-mails addressed to CLIENTS (onboarding, payment requests, invoices, renewal reminders, client logins and resets) from a
# client-facing address on its own domain. Staff, HR and careers e-mails keep EMAIL_FROM. Both go through the SAME account / API key:
# with Resend, verify both domains in that one account (the free plan allows one domain). Not set: everything uses EMAIL_FROM.
# EMAIL_FROM_CLIENT=Amuwa <hello@amuwa.com>
# EMAIL_REPLY_TO_CLIENT=hello@amuwa.com
# Optional senders per kind of e-mail (any address on the domain verified with the provider; not set: EMAIL_FROM / EMAIL_REPLY_TO):
# EMAIL_FROM_AUTH=Amuwa <auth@amuwa.com>          # password resets, sign-up / sign-in links, staff forgot-password
# EMAIL_REPLY_TO_AUTH=support@amuwa.com
# EMAIL_FROM_CAREERS=Amuwa Careers <careers@amuwa.com>   # candidate application updates
# EMAIL_REPLY_TO_CAREERS=
# EMAIL_FROM_HR=Amuwa HR <hr@amuwa.com>            # birthdays, anniversaries, probation, training, welcome e-mails
# EMAIL_REPLY_TO_HR=
# The Gmail mailbox's "Send mail as" aliases (comma separated): the SMTP backup may send as these; others go out as the mailbox itself.
# SMTP_SEND_AS=
# EMAIL_CC=
# EMAIL_BCC=
# WhatsApp: the 1automations Automation Builder webhook (regenerate it; never commit it).
# WHATSAPP_WEBHOOK_URL=
# The paid invoice also goes to this webhook (event stage_code INVOICE_PAID) unless Wabastore is set up: see docs/INVOICE_WHATSAPP.md.
# AUTOMATION_MODE_INVOICE_WHATSAPP=live   # optional: when unset, AUTOMATION_MODE decides
# The lead welcome WhatsApp ("our services", once when a lead first reaches a sales person) goes through Wabastore: see docs/LEAD_WHATSAPP.md.
# AUTOMATION_MODE_LEAD_WHATSAPP=live      # optional: off | dry_run | live; when unset, AUTOMATION_MODE decides
# WHATSAPP_SOURCE=Google Sheets    # the "source" value the WhatsApp router receives
# Only these recipients get messages while set (comma separated e-mails and phone numbers).
# AUTOMATION_TEST_RECIPIENTS=
# Encrypts the client password until the "Status Completed" email is sent (any long random string).
# AUTOMATION_SECRET_KEY=
# Bearer secret for POST /api/v1/internal/automations/dispatch (retries / safety net). At least 16 characters.
# AUTOMATION_DISPATCH_SECRET=
# Also skip the email when the WhatsApp number is invalid (the Apps Script's REQUIRE_VALID_WHATSAPP).
# AUTOMATION_REQUIRE_VALID_WHATSAPP=false

# The CRM's own web address, for the link in the emails to the Accounts payment desk (docs/ACCOUNTS_PAYMENT_EMAIL.md)
# APP_URL=https://crm.amuwacorporation.com   (links in client e-mails; this is also the default)

# Meetings with Google Calendar (docs/MEETINGS_GOOGLE_CALENDAR.md). Each employee connects their OWN Google account; without these
# three the Meetings page still works (CRM calendar, booking links, CEO requests, e-mails) but nothing reaches Google.
# GOOGLE_CLIENT_ID=                # Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_KEY=                # 32+ random characters: encrypts the stored Google tokens. Changing it disconnects everyone.
# GOOGLE_REDIRECT_URI=             # optional; default <APP_URL>/api/v1/integrations/google/callback (add exactly this in Google)
# MEETING_LINK_SECRET=             # optional, 32+ characters: signs the guests' private "cancel / answer" links (default: GOOGLE_TOKEN_KEY)

# File storage. New customer documents and invoice PDFs go to Cloudflare R2 when these are set (server only).
# Files stored earlier stay in Supabase Storage and keep opening. See docs/CLOUDFLARE_R2.md.
# STORAGE_PROVIDER=r2              # r2 | supabase (unset = r2 when the R2_* values below are all set)
# R2_ACCOUNT_ID=                   # Cloudflare dashboard -> R2 -> account id
# R2_ACCESS_KEY_ID=                # R2 -> Manage API tokens -> Object Read & Write, limited to the bucket
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=                       # the bucket name (create it private; keep "Public access" off)

# Biometric device gateway: the secret (16+ characters) it sends as "Authorization: Bearer <secret>" to
# POST /api/v1/integrations/biometric/punch with {"email": "...", "punchedAt": "2026-10-16T09:08:00+05:30"}.
# Without it the endpoint answers 503 and no biometric punch is recorded.
BIOMETRIC_INGEST_SECRET=

# Inbound lead webhook (/api/webhook, /api/webhooks/...). Senders (n8n, WhatsApp, forms) must send
# "X-Webhook-Secret: <value>" (or "Authorization: Bearer <value>"). Comma separated, each at least 16 characters.
# Until it is set the webhook accepts unauthenticated requests. See docs/SECURITY.md.
# WEBHOOK_SECRET=…
# Meta / WhatsApp subscription handshake: the verify token you typed in the Meta console.
# WEBHOOK_VERIFY_TOKEN=…

# Performance Management: the written analysis of a performance report (server only, never VITE_). Without a key the analysis is
# rule-based and says so. Only report figures, short task titles and delay reasons are sent. See docs/PERFORMANCE_MANAGEMENT.md.
# ANTHROPIC_API_KEY=
# PERFORMANCE_AI_MODEL=claude-sonnet-5-5
# PERFORMANCE_AI_TIMEOUT_MS=40000

# Sign-in location in Security & Audit Logs (Super Admin only). On Vercel the place comes from the platform's own headers: nothing to set.
# TRUST_PROXY_HEADERS=true   only behind a reverse proxy you control that sets x-real-ip / x-forwarded-for itself (not needed on Vercel).
# Optional IP lookup service, used only when the platform sends no place (server only, never VITE_). See docs/SECURITY.md.
# GEOIP_PROVIDER=ipinfo
# GEOIP_API_KEY=
# GEOIP_TIMEOUT_MS=1500

# Attendance place names (Punch In / Out coordinates shown to HR as "Baner Road, Baner, Pune ..."; server only, never VITE_).
# Without a key the free OpenStreetMap Nominatim service is used (one lookup a second). See docs/ATTENDANCE_PUNCH.md.
# GOOGLE_MAPS_API_KEY=
# GEOCODER_USER_AGENT=Amuwa-CRM/1.0 (employee attendance; reverse geocoding of punch locations)

# Server only: give up a database query after this many milliseconds (default 20000), so a busy database answers "busy, try again"
# instead of the request hanging until the 30-second platform limit. See docs/CHAT.md ("Many people online at once").
# USER_QUERY_TIMEOUT_MS=20000

# Abuse protection (docs/ABUSE_PROTECTION.md). Server only.
# Shared with the Candidate Portal (its own PORTAL_FORWARD_SECRET): lets the CRM count each candidate by their real address. 32+ characters.
# PORTAL_FORWARD_SECRET=
# Cloudflare Turnstile on the portal's forms: off (default) | log | enforce; the widget's secret key; the portal's host names.
# TURNSTILE_MODE=off
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ALLOWED_HOSTNAMES=careers.amuwa.com
# Throwaway e-mail domains to accept anyway (comma separated).
# DISPOSABLE_EMAIL_ALLOW=
# Every limit is a setting with the name in docs/ABUSE_PROTECTION.md, e.g.
# CAND_SIGNUP_PER_IP_HOUR=5

# -----------------------------------------------------------------------------
# Variables the server code reads that were missing from this file (names only: set real values in the Cloudflare dashboard, never here).
# "secret" = store as a Worker Secret / Vercel sensitive variable. Everything is server only; never prefix with VITE_.
# -----------------------------------------------------------------------------

# Platform and scheduling
# CRM_PLATFORM=cloudflare               # set by wrangler.jsonc on the Worker; tells the server the caller's address comes from Cloudflare
# SCHEDULED_ENABLED=true                # Cloudflare: the two daily automation runs do NOTHING until this is "true". Set it at go-live, in the same hour
#                                       # Vercel's cron is stopped (VERCEL_CRON_PAUSED below), so the automations never run on both platforms.
# VERCEL_CRON_PAUSED=true               # Vercel only: Vercel Cron's own calls to /internal/automations/dispatch are skipped (no redeploy needed)
# API_ACCESS_LOG=off                    # "off" silences the one-line-per-request log

# Sign-up / reset e-mails sent by the CRM (Supabase "Send Email" hook, docs/AUTH_EMAIL_HOOK.md)
# SUPABASE_AUTH_HOOK_SECRET=            # secret: the hook secret Supabase shows (v1,whsec_...)

# File storage (Cloudflare R2, docs/CLOUDFLARE_R2.md): R2_ACCOUNT_ID (or R2_ENDPOINT), R2_ACCESS_KEY_ID (secret), R2_SECRET_ACCESS_KEY (secret), R2_BUCKET
# R2_ENDPOINT=                          # optional S3 endpoint instead of R2_ACCOUNT_ID

# E-mail
# SMTP_SECURE=true                      # true for port 465 (default for 465), false for STARTTLS on 587
# EMAIL_API_BASE_URL=                   # tests only: a local mock of the e-mail provider
# HR_EMAIL_FROM_NAME=Amuwa Corporation HR
# HR_REPLY_TO=
# CAREER_EMAIL_MODE=off                 # off | dry_run | live  (candidate e-mails)
# RECRUITMENT_EMAIL=off                 # "off" stops the recruitment decision e-mails
# WELCOME_EMAIL=off                     # "off" stops the new-employee welcome e-mails

# WhatsApp / calling providers
# WABASTORE_WEBHOOK_URL=                # secret: the Wabastore send address
# WABASTORE_API_KEY=                    # secret
# WABASTORE_STATUS_SECRET=              # secret: 16+ characters; the delivery-report address checks it
# Wabastore lead webhooks read by the Wabastore panel (POST /api/v1/leads/webhook-fetch). One credential per lead source; the SERVER adds it
# (Authorization: Bearer + x-api-key) and only to https://webhooks.wabastore.com. The browser never holds it. Never prefix with VITE_.
# Sources: WHATSAPP, META, TELECALLER, BIZDEV, AICALLING, RCS. For `npm run dev` put the same names in .env.local. See docs/SECURITY.md.
# WABASTORE_SOURCE_TOKEN_WHATSAPP=
# WABASTORE_SOURCE_TOKEN_META=
# WABASTORE_SOURCE_TOKEN_TELECALLER=
# WABASTORE_SOURCE_TOKEN_BIZDEV=
# WABASTORE_SOURCE_TOKEN_AICALLING=
# WABASTORE_SOURCE_TOKEN_RCS=
# WABASTORE_TIMEOUT_MS=                 # 2000-30000
# BOLIFY_WEBHOOK_URL=                   # secret: BolifyAI calling webhook
# BOLIFY_API_KEY=                       # secret: the BolifyAI calling API key (x-api-key); alone (no webhook) it selects the calling API
# BOLIFY_API_URL=                       # default https://api.bolifyai.com/api/v1/playground/call
# BOLIFY_ASSISTANT_ID=                  # default 567eaefd-bc8f-42c2-8bff-c1d1ac2f97ba (panel recharge assistant)
# BOLIFY_DIALER_ID=                     # default c19c9cff-d96d-48b7-b163-1c62be020e6d
# BOLIFY_CALLBACK_SECRET=               # secret: 16+ characters; BolifyAI's call results at /api/v1/internal/bolify/call-status
# BOLIFY_PHONE_FORMAT=                  # 91 | 10 (default e164)
# BOLIFY_INCLUDE_CONTEXT=false
# BOLIFY_TIMEOUT_MS=
# INVOICE_WHATSAPP_LINK_TTL_SECONDS=    # how long an invoice link sent on WhatsApp stays valid

# AI writing (server only)
# ANTHROPIC_API_BASE_URL=               # default https://api.anthropic.com
# BA_AI_MODEL=
# BA_AI_TIMEOUT_MS=120000

# Bot check on the public forms (tests only)
# TURNSTILE_VERIFY_URL=

# Error reporting (Sentry, organization amuwa-corporation). Nothing is sent unless a DSN is set. See docs/ERROR_MONITORING.md.
# Website: DSN of the ai-crm-frontend project (build time; not a secret).
# VITE_SENTRY_DSN=
# API: DSN of the ai-crm-server project (run time on Vercel).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# Set by Vercel itself (do NOT set them): they are the defaults of the two settings above, so an issue shows which deployment caused it.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
# SENTRY_TRACES_SAMPLE_RATE=        # empty = tracing off on the API
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Readable stack traces: lets the BUILD upload source maps to Sentry (secret, build only, never commit).
# SENTRY_AUTH_TOKEN=
