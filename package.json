{
  "name": "unified-ai-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc && vite build && node docs-site/build.mjs --out=dist/documentation && node docs-site/build.mjs --audience=client --out=dist/client-docs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:db": "supabase/tests/run.sh",
    "test:api": "supabase/tests/run-api.sh",
    "test:unit": "supabase/tests/run-unit.sh",
    "bootstrap:super-admin": "node scripts/bootstrap-super-admin.mjs",
    "create:hr-login": "node scripts/create-hr-login.mjs",
    "docs:build": "node docs-site/build.mjs",
    "docs:build-client": "node docs-site/build.mjs --audience=client",
    "docs:check": "node docs-site/build.mjs --check",
    "docs:serve": "node docs-site/serve.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.13",
    "jszip": "^3.10.2",
    "lucide-react": "^0.428.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^16.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "docx": "^9.8.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
